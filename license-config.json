{
  "ignore": [
    ".claspignore",
    ".claude",
    ".editorconfig",
    ".github",
    ".gitignore",
    ".husky",
    ".nvmrc",
    ".prettierignore",
    "*.txt",
    "*.yaml",
    "*.yml",
    "CLAUDE.md",
    "CONTRIBUTING",
    "README.md",
    "build",
    "docs",
    "examples",
    "eslint.config.mjs",
    "rollup.config.mjs",
    "test",
    "vitest.config.ts"
  ],
  "license": "license-header.txt",
  "licenseFormats": {
    "js|ts|mjs": {
      "prepend": "/**",
      "append": " */",
      "eachLine": {
        "prepend": " * "
      }
    }
  },
  "trailingWhitespace": "TRIM"
}
