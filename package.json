{
  "name": "mf-invoice-api",
  "version": "1.0.0",
  "description": "マネーフォワード クラウド請求書API v3 GASクライアント",
  "main": "build/index.js",
  "license": "Apache-2.0",
  "keywords": [
    "typescript",
    "api-client",
    "google-apps-script",
    "app-script"
  ],
  "scripts": {
    "clean": "rimraf build dist",
    "lint": "npm run license && eslint --fix --no-error-on-unmatched-pattern src/ test/",
    "lint:fix": "eslint --fix --no-error-on-unmatched-pattern src/ test/",
    "lint:ci": "eslint --no-error-on-unmatched-pattern src/ test/",
    "format": "prettier --write src/ test/",
    "typecheck": "tsc --noEmit",
    "bundle": "rollup --no-treeshake -c rollup.config.mjs",
    "build": "npm run clean && npm run bundle && ncp appsscript.json dist/appsscript.json",
    "license": "license-check-and-add add -f license-config.json",
    "test": "vitest run",
    "deploy": "npm run lint && npm run test && npm run build && ncp .clasp-dev.json .clasp.json && clasp push -f",
    "deploy:prod": "npm run lint && npm run test && npm run build && ncp .clasp-prod.json .clasp.json && clasp push",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.11",
    "license-check-and-add": "^4.0.5",
    "ncp": "^2.0.0",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.2",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-typescript2": "^0.37.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-prettier": "^5.5.6",
    "factory.ts": "^1.4.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ],
    "test/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
